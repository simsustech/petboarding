{
  "srcDirs": ["packages/api/src", "packages/app/src", "packages/tools/src"],
  "exclude": [
    "node_modules",
    ".git",
    "dist",
    "build",
    ".pi/**",
    ".commandcode",
    ".github/**/*.md",
    ".context"
  ],
  "outputs": ["copilot"],
  "maxTokens": 16000,
  "autoMaxTokens": false,
  "coverageTarget": 0.95,
  "modelContextLimit": 200000,
  "maxTokensHeadroom": 0.3,
  "secretScan": true,
  "strategy": "full",
  "monorepo": true,
  "depMap": true,
  "changes": false,
  "changesCommits": 5,
  "todos": true
}
