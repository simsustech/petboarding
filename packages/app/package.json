{
  "name": "@petboarding/app",
  "version": "0.8.0",
  "private": true,
  "description": "Petboarding App",
  "license": "ELv2",
  "author": "simsustech",
  "files": [
    "dist/"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fastify-ssr-plugin": {
      "import": "./dist/ssr/server/fastify-ssr-plugin.mjs"
    },
    "./hooks": {
      "import": "./dist/ssr/server/virtual_vitrify-hooks.mjs"
    }
  },
  "scripts": {
    "dev": "vitrify dev",
    "dev:ssr": "vitrify dev -m ssr",
    "build": "run-s build:ssr",
    "build:debug": "vitrify build -m ssr --debug",
    "build:csr": "vitrify build",
    "build:ssr": "vitrify build -m ssr",
    "build:ssg": "vitrify build -m ssg",
    "minify:csr": "vitrify minify ./dist/csr",
    "minify:ssr:server": "vitrify minify ./dist/ssr/server",
    "minify:ssr:client": "vitrify minify ./dist/ssr/client",
    "minify:ssg": "vitrify minify ./dist/static",
    "minify:fastify": "vitrify minify ./dist/server",
    "generate:types": "vue-tsc -p tsconfig.types.json",
    "test": "vitrify test",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write ."
  },
  "dependencies": {
    "@fastify/middie": "9.3.6",
    "@fastify/static": "10.1.7",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@iconify-json/flagpack": "1.2.8",
    "@iconify-json/mdi": "1.2.3",
    "@modular-api/fastify-checkout": "0.12.0",
    "@modular-api/quasar-components": "0.3.45",
    "@petboarding/api": "workspace:*",
    "@petboarding/tools": "workspace:*",
    "@pinia/colada": "1.4.8",
    "@quasar/extras": "2.1.0",
    "@quasar/quasar-ui-qcalendar": "5.3.1",
    "@quasar/quasar-ui-qmarkdown": "4.2.1",
    "@simsustech/quasar-components": "0.12.14",
    "@timestamp-js/core": "1.0.0",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "@unocss/preset-icons": "66.11.0",
    "@unocss/preset-wind3": "66.11.0",
    "@unocss/preset-wind4": "^66.11.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/devtools-api": "^8.2.1",
    "@vue/reactivity": "3.5.44",
    "@vue/runtime-core": "3.5.44",
    "@vue/runtime-dom": "3.5.44",
    "@vue/server-renderer": "3.5.44",
    "@vue/shared": "3.5.44",
    "@vueuse/core": "15.0.0",
    "animated-unocss": "^0.0.6",
    "beasties": "0.5.5",
    "browser-image-resizer": "2.4.1",
    "date-fns": "4.4.0",
    "date-holidays": "3.38.0",
    "fastify": "5.12.7",
    "html2pdf.js": "0.14.0",
    "icon-gen": "5.0.0",
    "lionel-oauth-client": "npm:@stefanvh/lionel-oauth-client@^0.7.0",
    "npm-run-all": "4.1.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pinia": "4.1.0",
    "quasar": "2.35.2",
    "typescript": "7.0.2",
    "unocss": "66.11.0",
    "unocss-preset-quasar": "0.8.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.0.5",
    "vitrify": "0.30.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.13",
    "workbox-window": "7.4.1",
    "ws": "8.22.0"
  }
}
