{
  "name": "@petboarding/api",
  "version": "0.7.1",
  "private": true,
  "description": "Petboarding API",
  "license": "ELv2",
  "author": "simsustech",
  "files": [
    "dist/",
    "vitrify.config.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    },
    "./zod": {
      "import": "./src/zod/index.ts",
      "types": "./src/zod/index.ts"
    },
    "./trpc": {
      "types": "./src/trpc/index.ts"
    },
    "./types": {
      "import": "./src/kysely/types.ts",
      "types": "./src/kysely/types.ts"
    }
  },
  "scripts": {
    "serve": "node ./dist/server/server.mjs",
    "dev": "run-s docker-compose start:dev-server ",
    "build": "run-s build:api build:migrations seed:fake:generate minify:fastify",
    "build:migrations": "tsc -p tsconfig.migrations.json",
    "build:api": "vitrify build -m fastify",
    "build:debug": "run-s build:api:debug build:migrations seed:fake:generate",
    "build:api:debug": "vitrify build -m fastify --debug",
    "minify:csr": "vitrify minify ./dist/csr",
    "minify:ssr:server": "vitrify minify ./dist/ssr/server",
    "minify:ssr:client": "vitrify minify ./dist/ssr/client",
    "minify:ssg": "vitrify minify ./dist/static",
    "minify:fastify": "vitrify minify ./dist/server",
    "test": "vitrify test",
    "test:e2e": "playwright test",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "migrate:latest": "node ./dist/kysely/migrate.js",
    "seed:fake:generate": "node ./dist/kysely/seeds/fake/writeData.js",
    "seed:fake": "node ./dist/kysely/seeds/fake.js",
    "seed:test": "node ./dist/kysely/seeds/test.js",
    "seed:data": "node ./dist/kysely/seeds/data.js",
    "seed:vacations": "node ./dist/kysely/seeds/vacations.js",
    "start": "run-s migrate:latest serve",
    "start:dev-server": "NODE_TLS_REJECT_UNAUTHORIZED=0 vitrify dev -m fastify --port 3000",
    "docker-compose": "node ./docker-compose.dev.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/middie": "9.3.4",
    "@fastify/one-line-logger": "^2.2.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "10.1.4",
    "@modular-api/api": "^0.6.38",
    "@modular-api/fastify-checkout": "^0.11.0",
    "@modular-api/fastify-oidc": "^0.9.28",
    "@petboarding/app": "workspace:*",
    "@petboarding/tools": "workspace:*",
    "@pinia/colada": "1.4.5",
    "@simsustech/quasar-components": "0.12.10",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@vitrify/tools": "^0.5.4",
    "bcryptjs": "^3.0.3",
    "compress-tag": "^3.0.0",
    "date-fns": "^4.4.0",
    "date-holidays": "^3.36.1",
    "fastify": "^5.12.5",
    "handlebars": "^4.7.9",
    "kysely": "^0.29.6",
    "npm-run-all": "^4.1.5",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.2",
    "pinia": "^4.0.3",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/flagpack": "^1.2.8",
    "@iconify-json/mdi": "^1.2.3",
    "@playwright/test": "1.63.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.23.1",
    "@unocss/preset-icons": "^66.10.5",
    "@unocss/preset-wind3": "^66.10.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "6.0.9",
    "beasties": "^0.5.4",
    "docker-compose": "^1.5.0",
    "kysely-codegen": "^0.20.0",
    "oidc-provider": "^9.12.2",
    "openid-client": "^6.8.8",
    "quasar": "2.33.0",
    "typescript": "7.0.2",
    "unocss": "^66.10.5",
    "unocss-preset-quasar": "^0.5.6",
    "vite": "8.3.0",
    "vitrify": "^0.28.1",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "productName": "Petboarding"
}
